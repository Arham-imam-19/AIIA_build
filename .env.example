# Copy to .env and adjust if you like. Docker Compose picks .env up automatically.
# Defaults are baked into docker-compose.yml, so .env is optional for the demo.

POSTGRES_USER=aiia
POSTGRES_PASSWORD=aiia
POSTGRES_DB=aiia_ctms

# Only needed when running the backend directly on your laptop (no Docker).
# Inside Docker the hostname is "db"; from the host it is "localhost".
# DATABASE_URL=postgresql+psycopg://aiia:aiia@localhost:5432/aiia_ctms
